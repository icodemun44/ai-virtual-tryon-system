{
  "manifest_version": 3,
  "name": "Virtual Try-On Extension",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "description": "Upload your picture and try on products from any website",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["result.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
